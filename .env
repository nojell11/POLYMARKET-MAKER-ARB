# Polymarket Arbitrage Bot - Environment Variables
# Copy this file to .env and fill in your values

# =============================================
# POLYMARKET API CREDENTIALS
# =============================================
# Get these by running: node src/license.js (with your private key)
# Or use the derive-api-creds.js tool

CLOB_API_KEY=your-api-key-here
CLOB_SECRET=your-secret-here
CLOB_PASS_PHRASE=your-passphrase-here
POLY_ADDRESS=0xYourWalletAddressHere

# =============================================
# LICENSE KEY
# =============================================
# Contact the bot owner to obtain a valid license key

LICENSE_KEY=2026-01-16-8663999EC83D5572

