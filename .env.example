# Environment Variables Template
# Copy to .env and fill in your values

# Polymarket CLOB API Configuration (L2 HMAC-SHA256 Auth)
CLOB_API_URL=https://clob.polymarket.com
CLOB_API_KEY=your_api_key_here
CLOB_SECRET=your_secret_here
CLOB_PASS_PHRASE=your_passphrase_here

# Legacy aliases (for compatibility)
POLYMARKET_API_KEY=your_api_key_here
POLYMARKET_PRIVATE_KEY=your_private_key_here
POLYMARKET_CHAIN_ID=137

# Deployment Configuration
NODE_ENV=production
REGION=eu-west
PORT=3000

# Optional: Override default config values
# OPPORTUNITY_THRESHOLD=0.998
# ORDER_SIZE=6
# MAX_PARALLEL_POSITIONS=5
# CAPITAL_TOTAL=100
