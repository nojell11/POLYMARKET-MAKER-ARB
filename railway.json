{
    "$schema": "https://railway.app/railway.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "buildCommand": "npm install"
    },
    "deploy": {
        "numReplicas": 1,
        "region": "eu-west",
        "restartPolicyType": "ON_FAILURE",
        "restartPolicyMaxRetries": 3,
        "startCommand": "npm start",
        "healthcheckPath": "/health",
        "healthcheckTimeout": 10
    },
    "env": {
        "NODE_ENV": "production"
    }
}